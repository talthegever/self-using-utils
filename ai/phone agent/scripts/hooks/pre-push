#!/bin/sh
# Pre-push gate for PhoneAgent.
#
# Runs brain-server's pytest suite and android-app's JVM unit tests before
# allowing a push, but ONLY when the push actually touches files under
# "ai/phone agent/" - this repo (self-using-utils) hosts other unrelated
# projects, and their pushes should never be slowed down or blocked by
# this project's tests.
#
# One-time setup (run once from the repo root). This is a REPO-WIDE
# setting - if you already point core.hooksPath somewhere else for another
# project's hooks, merge that setup with this script instead of
# overwriting it:
#
#   git config core.hooksPath "ai/phone agent/scripts/hooks"
#
# Known limitation: the JAVA_HOME path below is hardcoded to this
# machine's Temurin JDK 17 install. If that ever moves, update it here.

project_touched=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    if git diff --name-only "$range" -- "ai/phone agent/" | grep -q .; then
        project_touched=1
    fi
done

if [ "$project_touched" -eq 0 ]; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
project_dir="$repo_root/ai/phone agent"

echo "PhoneAgent: push touches ai/phone agent/ - running tests first..."

( cd "$project_dir/brain-server" && ./.venv/Scripts/python.exe -m pytest -q )
if [ $? -ne 0 ]; then
    echo "PhoneAgent: brain-server tests failed - push aborted."
    exit 1
fi

JAVA_HOME="C:\Program Files\Eclipse Adoptium\jdk-17.0.20.101-hotspot" \
    "$project_dir/android-app/gradlew.bat" -p "$project_dir/android-app" testDebugUnitTest -q
if [ $? -ne 0 ]; then
    echo "PhoneAgent: android-app unit tests failed - push aborted."
    exit 1
fi

echo "PhoneAgent: all tests passed."
exit 0
